#!/bin/bash
# usage: git-backup [interval_seconds]
INTERVAL=${1:-60}

git pull --rebase || exit 1

while true; do
    if [ -n "$(git status --porcelain)" ]; then
        git add -A && git commit -qm "Backup $(date)"
    fi

    if git pull --rebase -q && git push -q; then
        echo "Synced at $(date)"
    else
        git rebase --abort 2>/dev/null
        echo "Sync FAILED at $(date)" >&2
    fi

    sleep "$INTERVAL"
done
